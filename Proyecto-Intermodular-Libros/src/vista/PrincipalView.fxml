            <Button fx:id="btnCerrarSesion" layoutX="680.0" layoutY="453.0" mnemonicParsing="false" text="Cerrar Sesión" />
            <TableView fx:id="tablaLibros" layoutX="211.0" layoutY="111.0" prefHeight="336.0" prefWidth="512.0">
              <columns>
                <TableColumn fx:id="colTitulo" prefWidth="164.0" text="Título" />
                <TableColumn fx:id="colAutor" prefWidth="88.79998779296875" text="Autor" />
                  <TableColumn fx:id="colGenero" prefWidth="85.59994506835938" text="Género" />
                  <TableColumn fx:id="colPuntuacion" prefWidth="88.0" text="Puntuación" />
