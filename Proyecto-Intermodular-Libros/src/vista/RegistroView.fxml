<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.RegistroControlador">
   <children>
      <AnchorPane layoutY="-5.0" prefHeight="419.0" prefWidth="611.0">
         <children>
            <VBox alignment="CENTER" layoutX="116.0" layoutY="58.0" prefHeight="336.0" prefWidth="347.0">
               <children>
                  <Label text="Registro de Usuario">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtNombreUsuario" promptText="Nombre de Usuario" />
                  <TextField fx:id="txtEmail" promptText="Correo Electrónico" />
                  <PasswordField fx:id="txtPassword" promptText="Contraseña" />
                  <PasswordField fx:id="txtConfirmarPassword" promptText="Repite Contraseña" />
                  <Button fx:id="btnRegistrar" mnemonicParsing="false" text="Registrarse" />
                  <Button fx:id="btnVolver" mnemonicParsing="false" text="Cancelar" />
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
